{
  "name": "@excellent-wealth/api",
  "version": "0.2.0",
  "private": true,
  "description": "Excellent Wealth backend API: authentication, sessions, and (over time) the rest of the financial data endpoints.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/integration/**' --exclude '**/security/**'",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:all": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@excellent-wealth/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^5.21.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@excellent-wealth/config": "workspace:*",
    "@types/node": "^26.1.1",
    "pino": "^10.3.1",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
