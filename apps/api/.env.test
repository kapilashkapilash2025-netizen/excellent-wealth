# Committed test-only defaults (no real secrets) — used as a fallback when
# these variables aren't already set in the environment (e.g. by CI). Matches
# the docker-compose.yml postgres service. See docs/development/database-setup.md.
NODE_ENV=test
API_PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excellent_wealth_test?schema=public
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=excellent_wealth_session
SESSION_SECRET=test-only-session-secret-not-used-outside-automated-tests-00000
SESSION_TTL_HOURS=168
PASSWORD_PEPPER=
LOG_LEVEL=silent
