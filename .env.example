# Excellent Wealth — environment configuration template
# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (apps/api, Prisma) ---
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://excellent_wealth:changeme@localhost:5432/excellent_wealth?schema=public

# --- Auth / sessions ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-generated-32-byte-secret
SESSION_COOKIE_NAME=ew_session
SESSION_MAX_AGE_SECONDS=2592000

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Feature flags ---
ENABLE_LOCAL_DEMO_MODE=true
ENABLE_EXPLAINABLE_INSIGHTS=true
