# Excellent Wealth — environment configuration template
# Copy this file to apps/api/.env (and adjust as needed) and fill in real
# values. Never commit .env. See docs/development/database-setup.md and
# docs/development/api-setup.md for local setup instructions.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- apps/api ---
API_PORT=4000
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excellent_wealth?schema=public
# Comma-separated list of origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:3000

# --- Auth / sessions ---
SESSION_COOKIE_NAME=excellent_wealth_session
# Generate with: openssl rand -base64 32 (must be at least 32 characters)
SESSION_SECRET=replace-with-a-generated-32-byte-secret
SESSION_TTL_HOURS=168
# Optional extra secret mixed into password hashing. Leave blank to disable.
PASSWORD_PEPPER=

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Feature flags (apps/web) ---
ENABLE_LOCAL_DEMO_MODE=true
ENABLE_EXPLAINABLE_INSIGHTS=true
